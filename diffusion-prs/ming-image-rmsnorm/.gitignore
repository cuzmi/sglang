# Archive only reviewed experiment sources and compact evidence.
/*
!/.gitignore
!/README.md
!/EXPERIMENT.md
!/REPORT.md
!/PR_BODY_DRAFT.md
!/PR_TITLE.txt
!/TEST_REVIEW.md
!/EVIDENCE.json
!/source_manifest.json
!/candidate.patch
!/micro-summary.json
!/experiment.py
!/verify_rmsnorm.py
!/analyze_results.py
!/prepare_inputs.py
!/inputs/
/inputs/*
!/inputs/candidate_ming_image.py
!/inputs/test_rmsnorm_preserve_reduction.py
!/inputs/test_model_fast_paths.py
!/evidence/
/evidence/*
!/evidence/analysis.json
!/evidence/full-manifest.json
!/evidence/kernel-tests.txt
!/evidence/micro-manifest.json
!/evidence/micro.json
!/evidence/original_artifact_hashes.json
!/evidence/pre-commit.txt
!/evidence/wrapper-tests.txt

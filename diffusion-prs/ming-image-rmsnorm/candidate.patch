+@requires_inline_ptx
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float16])
+@pytest.mark.parametrize("shape", [(257, 128), (1, 320, 2560), (2, 257, 3840)])
+def test_ming_rmsnorm_fast_path(dtype, shape):
+    import sglang.multimodal_gen.runtime.models.dits.ming_image as ming
+    from sglang.srt.layers.layernorm import RMSNorm as NativeRMSNorm
+
+    gate = BitExactFusionGate("test Ming RMSNorm", per_signature=True)
+    norm = ming.MingRMSNorm(shape[-1]).cuda().to(dtype)
+    with torch.no_grad():
+        norm.weight.normal_()
+    x = torch.randn(shape, device="cuda", dtype=dtype)
+    with (
+        patch.object(ming, "_MING_RMSNORM_FUSION", gate),
+        patch.object(
+            ming, "rmsnorm_preserve_reduction", wraps=ming.rmsnorm_preserve_reduction
+        ) as fused,
+    ):
+        for _ in range(2):
+            x.normal_()
+            assert torch.equal(norm(x), NativeRMSNorm.forward_native(norm, x))
+        assert fused.call_count == 2
+        assert gate.verified and not gate.disabled
+
+
+@requires_inline_ptx
+@pytest.mark.parametrize("case", ["fp32", "strided", "residual", "mismatch"])
+def test_ming_rmsnorm_fallback(case):
+    import sglang.multimodal_gen.runtime.models.dits.ming_image as ming
+    from sglang.srt.layers.layernorm import RMSNorm as NativeRMSNorm
+
+    gate = BitExactFusionGate("test Ming RMSNorm", per_signature=True)
+    dtype = torch.float32 if case == "fp32" else torch.bfloat16
+    norm = ming.MingRMSNorm(3840).cuda().to(dtype)
+    x = torch.randn(2, 17, 3840, device="cuda", dtype=dtype)
+    if case == "strided":
+        x = x.transpose(0, 1)
+    residual = torch.randn_like(x) if case == "residual" else None
+    with (
+        patch.object(ming, "_MING_RMSNORM_FUSION", gate),
+        patch.object(
+            ming, "rmsnorm_preserve_reduction", return_value=torch.zeros_like(x)
+        ) as fused,
+    ):
+        actual = norm(x, residual)
+        expected = NativeRMSNorm.forward_native(norm, x, residual)
+        if residual is not None:
+            assert all(torch.equal(a, b) for a, b in zip(actual, expected))
+        else:
+            assert torch.equal(actual, expected)
+        assert fused.call_count == (1 if case == "mismatch" else 0)
+        assert gate.disabled == (case == "mismatch")
+        assert not gate.verified
+        if case == "mismatch":
+            assert torch.equal(norm(x), expected)
+            assert fused.call_count == 1
+
+
+@requires_inline_ptx
+def test_ming_rmsnorm_compile_and_graph():
+    import sglang.multimodal_gen.runtime.models.dits.ming_image as ming
+    from sglang.srt.layers.layernorm import RMSNorm as NativeRMSNorm
+
+    norm = ming.MingRMSNorm(3840).cuda().bfloat16()
+    x = torch.randn(1, 17, 3840, device="cuda", dtype=torch.bfloat16)
+    gate = BitExactFusionGate("test Ming RMSNorm", per_signature=True)
+    with patch.object(ming, "_MING_RMSNORM_FUSION", gate):
+        # Inductor continues to see exactly the native expression.
+        compiled = torch.compile(norm, backend="eager", fullgraph=True)
+        with patch.object(ming, "rmsnorm_preserve_reduction") as fused:
+            assert torch.equal(compiled(x), NativeRMSNorm.forward_native(norm, x))
+            fused.assert_not_called()
+        assert not gate.verified
+        stream = torch.cuda.Stream()
+        stream.wait_stream(torch.cuda.current_stream())
+        with torch.cuda.stream(stream):
+            for _ in range(3):
+                norm(x)
+        torch.cuda.current_stream().wait_stream(stream)
+        assert gate.verified and not gate.disabled
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            out = norm(x)
+        x.normal_()
+        graph.replay()
+        assert torch.equal(out, NativeRMSNorm.forward_native(norm, x))
+
